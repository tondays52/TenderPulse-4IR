# ==============================================================================
# TenderPulse 4IR - Enterprise Production Environment Configuration
# ==============================================================================

# Application & Network
ENVIRONMENT=development
HOST_PORT=8080
INTERNAL_PORT=8000
DEBUG=False
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:8080,http://localhost:8080
STRICT_AUTH=false
ALLOW_PUBLIC_REGISTRATION=false
MAX_UPLOAD_MB=25

# Copernicus Sentinel Hub & Planet Spatial Gateways
SH_CLIENT_ID=
SH_CLIENT_SECRET=
SH_INSTANCE_ID=01a74708-c309-40e7-aacd-e69298313ecc

# Database Persistence (SQLite locally; Docker Compose supplies PostgreSQL)
DATABASE_URL=sqlite:///./data/tenderpulse.db
POSTGRES_USER=tenderpulse
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password
POSTGRES_DB=tenderpulse

# Cache & Message Broker
REDIS_URL=redis://redis:6379/0

# Cryptographic Authentication (Phase 3)
JWT_SECRET_KEY=replace-with-a-long-random-secret-before-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# One-time administrator provisioning (set locally; never commit a password)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=TenderPulse Administrator
BOOTSTRAP_ADMIN_AGENCY=TenderPulse

# Ingestion & Scraper Configuration
EGP_SCRAPER_RATE_LIMIT_SEC=15
EGP_MAX_RETRIES=3
ALERT_WEBHOOK_URL=
BACKUP_RETENTION_DAYS=14

# Independent e-GP harvester worker (production Compose)
HARVEST_INTERVAL_SEC=900
HARVEST_LIMIT_PER_AGENCY=5
HARVEST_HEALTH_MAX_AGE_SEC=2100
