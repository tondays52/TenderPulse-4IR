# ==============================================================================
# TenderPulse 4IR - Enterprise Production Environment Configuration
# ==============================================================================

# Application & Network
ENVIRONMENT=production
HOST_PORT=8080
INTERNAL_PORT=8000
DEBUG=False
CORS_ORIGINS=*

# Copernicus Sentinel Hub & Planet Spatial Gateways
SH_CLIENT_ID=
SH_CLIENT_SECRET=
SH_INSTANCE_ID=01a74708-c309-40e7-aacd-e69298313ecc

# Database Persistence (PostgreSQL for Phase 2, defaults to SQLite if unset)
DATABASE_URL=sqlite:///./data/tenderpulse.db

# Cache & Message Broker
REDIS_URL=redis://redis:6379/0

# Cryptographic Authentication (Phase 3)
JWT_SECRET_KEY=tenderpulse_production_secret_key_change_in_real_vault_4ir
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Ingestion & Scraper Configuration
EGP_SCRAPER_RATE_LIMIT_SEC=15
EGP_MAX_RETRIES=3
ALERT_WEBHOOK_URL=
